# Optional. Only needed for google_static / google_js backends.
GOOGLE_MAPS_API_KEY=

# Optional. Open street-level imagery: https://www.mapillary.com/dashboard/developers
MAPILLARY_TOKEN=

# Default: public Street View in Chromium, no key.
# google_web | google_js | google_static | mapillary
PS1HOOD_SOURCE=google_web
